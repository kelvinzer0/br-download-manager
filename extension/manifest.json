{
  "manifest_version": 3,
  "name": "BR Download Manager",
  "version": "1.1",
  "key": "",
  "description": "Forward downloads to aria2 via Rust Native Host",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "downloads.shelf",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:6800/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BR Download Manager"
  },
  "minimum_chrome_version": "88"
}
